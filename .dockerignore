# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/

# Virtual Environment
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Docs
README.md
CLAUDE.md
ROADMAP.md

# Logs
*.log

# Local config
.env
config.local.py

# Live deployment modules — never bake these into an image layer. They carry
# current standings and staging, and an image can be pushed or shared. They
# reach the container as a read-only volume mount instead (docker-compose.yml).
private/
deployments/local_*.py

# Demo mode
demo.py

# Developer tools. Most of these run on a workstation — they resolve IDs from
# ESI, scaffold a new deployment module, or scp one to a server — and have no
# business in a production image.
#
# The exceptions are the two that operate on the *production database*, which
# only exists inside the container (intel.db is bind-mounted, and private/
# war and deployment modules arrive the same way). Excluding them meant the
# only place they can run was the one place they weren't.
tools/
!tools/backfill_war.py
!tools/migrate_deployment_ids.py

# Node modules (installed in Docker stage 1, not from host)
frontend/node_modules/

# Vite build output (built in stage 1, overlaid via COPY --from)
static/dist/

# Database (never bake into image, persisted via volume)
intel.db
intel.db-wal
intel.db-shm

# Fish scripts
*.fish
setup.fish
run_dev.fish

# Deploy docs
DEPLOY*.md
discord-post.md

# Deploy/update scripts (run on host, not inside container)
scripts/
update.sh
quick-update.sh
