# EVE Intel Dashboard — Environment Configuration
# Copy to .env and fill in real values: cp .env.example .env

# Which deployment module to load (matches deployments/<name>.py)
DEPLOYMENT=lawn_perrigen

# Password to add/delete timers/entosis nodes/annotations/jump bridges.
# Kept as a FALLBACK when EVE SSO is not configured (below). If both this and
# SSO are unset, writes are disabled (the app uses a random per-process token).
TIMER_PASSWORD=

# ===== EVE SSO (optional, recommended) =====
# When all three EVE_* values are set, "Log in with EVE" becomes the primary
# auth for writes and the password above is just a fallback.
#
# Register an app at https://developers.eveonline.com/applications:
#   - Type: "Authentication Only" (no ESI scopes needed)
#   - Callback URL: https://<your-domain>/api/auth/sso/callback
#   NOTE: EVE allows ONE callback URL per app — register a SEPARATE app for
#   local dev with callback http://localhost:5000/api/auth/sso/callback.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=

# Signs the session cookie. MUST be a persistent random string in prod, or
# every restart logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Who may write after SSO login. The primary alliance is always allowed; these
# add extra alliances and specific characters (FCs/guests). Comma-separated IDs.
AUTH_ALLOWED_ALLIANCE_IDS=
AUTH_ALLOWED_CHARACTER_IDS=

# ===== AI threat summaries (optional) =====
# Enables the "AI SUMMARY" button in the D-scan and Local scanner panels
# (POST /api/ai/threat_summary, gated by write auth). Without this the endpoint
# returns 501 and the button is simply unavailable. Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== Background poller =====
# How often (seconds) to sample ESI for the ADM + activity history that powers
# sparklines, grinding rates, the heatmap, and regional spike baselines. This
# runs independently of page views, so history no longer has gaps when nobody
# has the dashboard open. db dedupes to at most one sample per system per hour,
# so polling faster than 3600 only reduces the cost of a missed window.
POLL_INTERVAL_SECONDS=900

# ===== Rate limiting =====
# Per-IP caps on the unauthenticated intel endpoints, which fan out to
# zKillboard (up to 25 requests per call). Storage is per-worker in memory, so
# the effective ceiling is workers × limit; point at Redis for an exact cap.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_INTEL_SCAN=20 per minute
RATELIMIT_AI=10 per minute

# Flask settings (rarely need changing)
FLASK_PORT=5000
FLASK_DEBUG=false
# Log verbosity for both the app and gunicorn: debug | info | warning | error
LOG_LEVEL=info
# Gunicorn worker count (production only)
GUNICORN_WORKERS=2
