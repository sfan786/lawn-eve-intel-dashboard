# EVE Intel Dashboard — Environment Configuration
# Copy to .env and fill in real values: cp .env.example .env

# Which deployment module to load (matches deployments/<name>.py)
DEPLOYMENT=lawn_perrigen

# Password to add/delete timers/entosis nodes/annotations/jump bridges.
# Kept as a FALLBACK when EVE SSO is not configured (below). If both this and
# SSO are unset, writes are disabled (the app uses a random per-process token).
TIMER_PASSWORD=

# ===== EVE SSO (optional, recommended) =====
# When all three EVE_* values are set, "Log in with EVE" becomes the primary
# auth for writes and the password above is just a fallback.
#
# Register an app at https://developers.eveonline.com/applications:
#   - Type: "Authentication Only" (no ESI scopes needed)
#   - Callback URL: https://<your-domain>/api/auth/sso/callback
#   NOTE: EVE allows ONE callback URL per app — register a SEPARATE app for
#   local dev with callback http://localhost:5000/api/auth/sso/callback.
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=

# Signs the session cookie. MUST be a persistent random string in prod, or
# every restart logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Who may write after SSO login. The primary alliance is always allowed; these
# add extra alliances and specific characters (FCs/guests). Comma-separated IDs.
AUTH_ALLOWED_ALLIANCE_IDS=
AUTH_ALLOWED_CHARACTER_IDS=

# ===== AI threat summaries (optional) =====
# Enables the "AI SUMMARY" button in the D-scan and Local scanner panels
# (POST /api/ai/threat_summary, gated by write auth). Without this the endpoint
# returns 501 and the button is simply unavailable. Get a key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== Background poller =====
# How often (seconds) to sample ESI for the ADM + activity history that powers
# sparklines, grinding rates, the heatmap, and regional spike baselines. This
# runs independently of page views, so history no longer has gaps when nobody
# has the dashboard open. db dedupes to at most one sample per system per hour,
# so polling faster than 3600 only reduces the cost of a missed window.
POLL_INTERVAL_SECONDS=900

# ===== Traffic analytics =====
# Counts dashboard usage (unique visitors, page loads, API calls) into two
# rollup tables so you can tell whether the app is still worth running. No IPs
# or user agents are stored — visitors are a salted hash of IP + browser.
ANALYTICS_ENABLED=true

# Who may READ the stats at /analytics. Closed by default: with both of these
# unset, traffic is still recorded but nobody can read it. Deliberately NOT
# TIMER_PASSWORD or the SSO write allowlist — those are fleet-wide, so either
# would let any alliance member read your usage numbers.
#
# Comma-separated EVE character IDs (requires SSO to be configured above).
# Find yours: python tools/esi_lookup.py zkill "Your Pilot Name" --type character
ANALYTICS_ALLOWED_CHARACTER_IDS=
# A password used ONLY for analytics. Sent as the X-Analytics-Auth header.
# Don't reuse TIMER_PASSWORD — that one is handed out to the fleet.
ANALYTICS_PASSWORD=
# Salt for the visitor hash. Defaults to FLASK_SECRET_KEY; set this separately
# only if you want to rotate visitor identities without logging everyone out.
ANALYTICS_SALT=
# How long counts may sit in memory before being written to SQLite. Keeps a DB
# write off the path of every dashboard poll; a crash loses at most one window.
ANALYTICS_FLUSH_SECONDS=60
# Rollups older than this are pruned (once a day, from the flush path).
ANALYTICS_RETENTION_DAYS=180

# ===== Reverse proxy =====
# How many proxy hops in front of this app may be trusted to have set
# X-Forwarded-For. Set to 1 if you run the nginx from nginx.conf (or any single
# reverse proxy / load balancer); leave 0 if the app is exposed directly.
#
# Why it matters: with 0, Flask sees the proxy's own address as the client, so
# EVERY user shares one per-IP rate-limit bucket — one noisy visitor throttles
# the intel endpoints for the whole alliance. The app logs a warning if it sees
# forwarded requests while this is 0.
#
# Never set it higher than the number of proxies you control: each extra hop is
# one a client can forge to impersonate another address.
TRUSTED_PROXY_HOPS=0

# ===== Rate limiting =====
# Per-IP caps on the unauthenticated intel endpoints, which fan out to
# zKillboard (up to 25 requests per call). Storage is per-worker in memory, so
# the effective ceiling is workers × limit; point at Redis for an exact cap.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_INTEL_SCAN=20 per minute
RATELIMIT_AI=10 per minute
# Caps guesses at ANALYTICS_PASSWORD over the network. Normal use costs a few
# requests per page load, so leave headroom; 20/min still makes online
# guessing hopeless.
RATELIMIT_ANALYTICS=20 per minute

# Flask settings (rarely need changing)
FLASK_PORT=5000
FLASK_DEBUG=false
# Log verbosity for both the app and gunicorn: debug | info | warning | error
LOG_LEVEL=info
# Gunicorn worker count (production only)
GUNICORN_WORKERS=2

# ===== Active deployment =====
# Which deployment module to load. The loader checks private/<name>.py first
# (gitignored, mounted from ./private on a server), then deployments/<name>.py.
# Leave unset to use the default reference deployment.
#DEPLOYMENT=my_deployment
# Override where private deployment modules are read from. docker-compose sets
# this to /app/private, matching the read-only volume mount.
#DEPLOYMENT_DIR=/app/private

# Per-IP cap on the region kill feed and hostile tracker. They accept any
# known-space region, so this bounds how fast one client can walk all of them
# and miss the per-region cache. Generous by design.
#RATELIMIT_REGION_FEED=60 per minute

# ===== War tracker (/war) =====
# All optional — the values below are the defaults. The war tracker runs
# correctly with none of these set; they exist for tuning.
#
# Wars themselves are defined by a module in private/wars/ (see wars/example.py
# for the template), not here. With no war module loaded, /api/wars returns an
# empty list and the page hides itself.

# How often (seconds) the poller samples zKillboard. Each cycle is one request
# per war region, so this is the main cost knob. Feed freshness is this plus
# zKillboard's own ingest lag, so 600 means the page can be ~11 min behind.
#WAR_POLL_INTERVAL_SECONDS=600

# Page cap per region per cycle (200 kills each). Hitting it flags the region
# as saturated on /api/wars/<key>/status rather than silently dropping kills.
#WAR_MAX_PAGES_PER_CYCLE=6

# How far before the stored cursor to re-ask, so a kill that reaches zKillboard
# late is not missed by an exact-boundary window.
#WAR_WINDOW_OVERLAP_SECONDS=900

# Retention. 0 keeps belligerent kills forever — the historical record is the
# point of the ledger, and it is ~0.5 MB/day. Third-party kills are stored only
# to keep the "already seen" filter honest, so they expire sooner.
#WAR_RETENTION_DAYS=0
#WAR_THIRD_PARTY_DAYS=180

# Where war modules are read from. Defaults to <repo>/private/wars, which is
# already inside the read-only ./private mount in docker-compose — only set
# this if the modules live somewhere else. A wrong path means no wars load,
# which is deliberately not fatal, so the page just goes empty.
#WAR_DIR=/app/private/wars
